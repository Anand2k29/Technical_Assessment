# Copy this file to .env and fill in what you have. AUTOPSY runs fully
# functional in DEMO MODE with none of these set (see /api/system/status).

# If set, the LLM-powered paths (lesson script generation, question wording,
# nuanced response grading, misconception classification, translation) go
# live via the Anthropic Messages API. If unset, every agent uses its own
# deterministic rule-based fallback instead -- the app never fakes a live
# result while claiming one.
ANTHROPIC_API_KEY=
